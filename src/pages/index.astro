---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Steps2 from '~/components/widgets/Steps2.astro';

const metadata = {
  title: 'CodeBridgeAI - Bridge to the Future World',
  description: '코드와 사람을 잇는 다리, CodeBridgeAI. 코딩 교육, LMS, 디지털사이니지, AI 솔루션을 통해 지식과 기술을 연결합니다.'
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '교육 플랫폼',
        href: '/edu',
        icon: 'tabler:school',
      },
      {
        variant: 'secondary',
        text: '비즈니스 솔루션',
        href: '/business',
        icon: 'tabler:building',
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'CodeBridgeAI Hero Image' }}
  >
    <Fragment slot="title">
      Bridge to the
      <span class="text-accent dark:text-white"> Future World</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-bold">CodeBridgeAI</span>는 </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">CodeBridgeAI</span>
      코드와 사람을 잇는 다리입니다.</br> 
      우리는 코딩 교육, 학습 관리 시스템(LMS), 디지털사이니지, 그리고 AI 솔루션 개발을 통해
      지식과 경험, 기술과 비즈니스를 연결합니다.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="브랜드 철학:" description="깊은 기술력으로 시작해서, 안정적인 기반을 구축하고, 무한한 가능성으로 확장하며, 혁신의 순간을 만들어낸다" />

  <!-- Features2 Widget ************** -->

  <Features2
    title="About us"
    subtitle="주식회사 CodeBridgeAI는 코드와 사람을 잇는 다리입니다. </br>우리는 코딩 교육, 학습 관리 시스템(LMS), 디지털사이니지, 그리고 AI 솔루션 개발을 통해 지식과 경험, 기술과 비즈니스를 연결합니다.">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Content Widget ***************** -->

  <Content
    id="content-one"
    tagline="CodeBridgeAI 브랜드 철학"
    title="코드와 사람을 잇는 다리"
    subtitle="우리는 코딩 교육, LMS, 디지털사이니지, AI 솔루션 개발을 통해 지식과 경험, 기술과 비즈니스를 연결합니다. 단순한 기술 제공을 넘어, 사람과 기술 사이의 의미있는 연결고리를 만들어갑니다."
    isReversed
    items={[
      {
        title: '상징의 의미 - <> 심볼이 담은 새로운 세계',
        description:
          '로고의 <> 심볼은 코드의 시작과 끝, 그리고 새로운 세계로의 진입을 상징합니다. 이 기호가 다리(Bridge)를 이루며 만들어내는 공간은 현재와 미래를 이어가는 연결을 표현하며, 무한한 가능성의 문을 열어줍니다.',
        icon: 'tabler:brackets-angle',
      },
      {
        title: '컬러의 가치 - 신뢰와 창의성의 조화',
        description:
          '깊은 블루의 신뢰성, 하늘빛의 확장성, 옐로우의 창의성을 담은 우리의 컬러 팔레트는 정교한 기술력과 따뜻한 교육적 가치가 공존하는 기업의 정체성을 보여줍니다.',
        icon: 'tabler:palette',
      },
      {
        title: '미래로의 여정 - 학습과 기술 기반의 혁신',
        description:
          'CodeBridgeAI는 끊임없는 학습과 첨단 기술을 바탕으로 개인과 조직, 그리고 사회 전체를 미래로 이끄는 든든한 다리 역할을 합니다. 우리와 함께 새로운 미래를 향한 여정을 시작하세요.',
        icon: 'tabler:building-bridge',
      },
    ]}
    image={{
      src: '~/assets/images/bridge.png',
      alt: 'CodeBridgeAI Brand Philosophy',
    }}
  >
  </Content>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="서비스"
    title="CodeBridgeAI의 핵심 서비스"
    subtitle="교육과 비즈니스의 경계를 넘어, 미래를 선도하는 기술 솔루션을 제공합니다."
    items={[
      {
        title: '코딩 교육 플랫폼',
        description:
          '블록 코딩부터 텍스트 코딩까지, 누구나 쉽게 프로그래밍을 배울 수 있습니다.',
        icon: 'tabler:code',
      },
      {
        title: '학습관리시스템(LMS)',
        description:
          '강의를 보면서 실시간으로 코딩도 함께 할 수 있고, AI로 바로 피드백까지 받을 수 있는 New generation LMS를 서비스합니다',
        icon: 'tabler:brain',
      },
      {
        title: '디지털사이니지 솔루션',
        description:
          '클라우드 기반 중앙 집중식 콘텐츠 관리로 효율적인 디지털 마케팅을 구현합니다.',
        icon: 'tabler:robot',
      },
      {
        title: 'AI 솔루션 개발',
        description:
          '기업과 조직의 디지털 전환(DX)을 위한 맞춤형 AI 솔루션을 개발합니다.',
        icon: 'tabler:robot',
      }
    ]}
  />

  
  <!-- FAQs Widget ******************** -->

  <FAQs
    tagline="자주 묻는 질문"
    title="궁금한 점이 있으신가요?"
    subtitle="CodeBridgeAI에 대한 자주 묻는 질문들을 확인해보세요"
    items={[
      {
        title: 'CodeBridgeAI는 어떤 회사인가요?',
        description: 'CodeBridgeAI는 코드와 사람을 잇는 다리 역할을 하는 기업으로, 코딩 교육, LMS, 디지털사이니지, AI 솔루션 개발을 통해 지식과 기술을 연결합니다.',
      },
      {
        title: '교육 플랫폼은 어떻게 이용할 수 있나요?',
        description: 'CodeBridgeAI Edu 플랫폼에서 블록 코딩부터 텍스트 코딩까지 다양한 교육 프로그램을 제공합니다. 무료 체험 버전도 이용 가능합니다.',
      },
      {
        title: '비즈니스 솔루션은 어떤 것들이 있나요?',
        description: '디지털사이니지 CMS, 노코딩 AI 자동화 솔루션 ,AI 솔루션 개발, 기업 맞춤형 디지털 전환(DX) 서비스를 제공합니다.',
      },
      {
        title: '기술 지원은 어떻게 받을 수 있나요?',
        description: '24/7 기술 지원을 통해 언제든지 도움을 받으실 수 있습니다. 이메일, 온라인 채팅을 통해 연락 가능합니다.',
      },
    ]}
  />

  <!-- CallToAction Widget ************ -->

  <CallToAction
    tagline="시작하기"
    title="미래로의 여정을 시작하세요"
    subtitle="CodeBridgeAI와 함께 코드로 미래 세상을 현실로 만들어보세요"
    actions={[
      {
        variant: 'primary',
        text: '교육 플랫폼',
        href: '/edu',
        icon: 'tabler:school',
      },
      {
        variant: 'secondary',
        text: '비즈니스 솔루션',
        href: '/business',
        icon: 'tabler:building',
      },
    ]}
  />
</Layout>
