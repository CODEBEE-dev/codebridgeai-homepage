---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { headerData } from '~/navigation';

// 이미지 import
import lmsImage from '~/assets/images/lms.png';
import eduImage from '~/assets/images/edu.png';
import codebeeImage from '~/assets/images/codebee.png';
import codebeeUsingImage from '~/assets/images/codebee-using.png';
import codeindocsImage from '~/assets/images/codeindocs.png';
import codeindocsUsingImage from '~/assets/images/codeindocs-using.png';
import lmsUsingImage from '~/assets/images/lms-using.png';
import lmsCodebridgeaiImage from '~/assets/images/lms-codebridgeai.png';

const metadata = {
  title: 'CodeBridgeAI Edu - 미래 인재를 위한 코딩 교육 & AI 학습 플랫폼',
  description: '블록 코딩부터 텍스트 코딩까지, AI 기반 맞춤형 학습으로 누구나 쉽게 프로그래밍을 배울 수 있습니다.'
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      {...headerData}
      actions={[
        {
          variant: 'secondary',
          text: '무료 체험',
          href: '#',
          'data-trial-modal': true
        },
      ]}
      isSticky
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    actions={[
      { variant: 'primary', text: '무료 체험 시작', href: '#', icon: 'tabler:play', 'data-trial-modal': true },
      { text: '문의하기', href: '/contact', icon: 'tabler:message' },
    ]}
    image={{
      src: lmsImage,
      alt: 'CodeBridgeAI Edu Platform',

      loading: 'eager',
      decoding: 'sync',
    }}
    classes={{
      container: 'intersect-no-queue',
    }}
  >
    <Fragment slot="title">
      <img src={eduImage.src} alt='CodeBridgeAI Edu Logo' class='h-20 md:h-40 mx-auto' loading='eager' decoding='sync' fetchpriority='high' />
    </Fragment>

    <Fragment slot="subtitle">
      미래 인재를 위한 코딩 교육 & AI 학습 플랫폼
    </Fragment>
  </Hero2>

  <!-- Content Widget **************** -->
  <Content
    id="block-coding"
    isReversed
    items={[
      {
        title: 'CodeBEE Lite',
        description: '무료 체험용 버전으로 블록 코딩의 기본 개념을 익힐 수 있습니다.',
        icon: 'tabler:gift',
      },
      {
        title: 'CodeBEE Pro',
        description: '머신러닝 기반 블록 코딩으로 개인별 맞춤 학습 경로를 제공합니다.',
        icon: 'tabler:brain',
      },
      {
        title: 'CodeBEE IoT',
        description: '마이크로비트, 아두이노 등을 활용한 실습 중심의 IoT 교육을 제공합니다.',
        icon: 'tabler:check',
        action: {
          text: 'CodeBEE IoT 체험하기',
          href: 'https://aiot.codebridge.ai.kr',
          target: '_blank',
        },
      },
      {
        title: 'CodeBEE AI Play',
        description: 'AI 체험형 교육 공간에서 인공지능의 원리를 재미있게 배워보세요.',
        icon: 'tabler:robot',
      },
    ]}
    image={{
      src: codebeeUsingImage,
      alt: 'CodeBEE Series',
      class: 'w-64 h-48 object-cover rounded-lg',
    }}
  >
    <Fragment slot="content">
      <img src={codebeeImage.src} alt='CodeBridgeAI Edu CodeBEE logo' class='h-20 md:h-40 mx-auto mb-4 block object-contain' />
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        블록 코딩의 시작: <br /><span class="text-2xl">CodeBEE 시리즈</span>
      </h3>
      <p class="text-lg text-muted dark:text-slate-400 mb-6">
        시각적 블록 조작으로 프로그래밍의 기초를 쉽게 배우세요
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a 
          href="https://hypy.codebridge.ai.kr" 
          target="_blank" 
          class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          CodeBEE 체험하기
        </a>
        <a 
          href="https://aiot.codebridge.ai.kr" 
          target="_blank" 
          class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          CodeBEE IoT 체험하기
        </a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="text-coding"
    isAfterContent={true}
    items={[
      {
        title: 'CodeJupyter',
        description: '파이썬, SQL 등 데이터분석과 AI교육에 특화된 주피터노트북을 설치없이 만나볼 수 있습니다.',
        icon: 'tabler:code',
      },
      {
        title: 'CodeInDocs',
        description: 'PPT와 웹북 그리고 강의영상을 보면서 코딩을 실시간으로 진행하여 이론과 실습을 동시에 진행합니다.',
        icon: 'tabler:file-text',
      },
    ]}
    image={{ src: codeindocsUsingImage, alt: 'Text Coding' }}
  >
    <Fragment slot="content">
      <img src={codeindocsImage.src} alt='CodeBridgeAI Edu CodeInDocs logo' class='h-20 md:h-40 mx-auto mb-4 block object-contain' />
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        텍스트 코딩: <br /><span class="text-2xl">실제 프로그래밍 언어 학습</span>
      </h3>
      <p class="text-lg text-muted dark:text-slate-400 mb-6">
        실제 코드를 작성하며 프로그래밍 언어를 마스터하세요
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="LMS"
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'AI 퀴즈 자동 생성',
        description: 'AI가 학습 내용을 분석하여 자동으로 퀴즈를 생성합니다. 개인별 학습 수준에 맞는 맞춤형 문제를 제공하여 효과적인 학습을 지원합니다.',
        icon: 'tabler:brain',
      },
      {
        title: 'AI 서술형 자동 채점 및 피드백',
        description: '서술형 답안을 AI가 자동으로 분석하고 채점합니다. 정확한 점수와 함께 개선점을 제시하는 상세한 피드백을 제공합니다.',
        icon: 'tabler:brand-github-copilot',
      },
      {
        title: '강의 보면서 실시간 코딩',
        description: '강의 영상을 보면서 동시에 실시간으로 코딩을 진행할 수 있습니다. 이론과 실습을 동시에 진행하여 학습 효과를 극대화합니다.',
        icon: 'tabler:play',
      },
      {
        title: '설치 없이 코드 퀴즈',
        description: '별도의 개발 환경 설치 없이 웹 브라우저에서 바로 코드 퀴즈를 풀 수 있습니다. 언제 어디서나 편리하게 학습할 수 있습니다.',
        icon: 'tabler:code',
      },
    ]}
    image={{
      src: lmsUsingImage,
      alt: 'CodeBridgeAI LMS',
    }}
  >
    <Fragment slot="content">
      <img src={lmsCodebridgeaiImage.src} alt='CodeBridgeAI LMS Logo' class='h-20 md:h-40 mx-auto mb-4 block object-contain' />
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        새로운 LMS: <br /><span class="text-2xl">AI 시대의 코딩 교육 플랫폼</span>
      </h3>
      <p class="text-lg text-muted dark:text-slate-400 mb-6">
        AI퀴즈 자동생성, AI 서술형 자동채점 및 피드백, 강의보면서 실시간 코딩, 설치없이 코드 퀴즈까지 가능한 CodeBridgeAI LMS입니다.
      </p>
      <div class="flex justify-center">
        <a 
          href="https://lms.codebridge.ai.kr" 
          target="_blank" 
          class="inline-flex items-center gap-2 px-6 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-700 transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          LMS 체험하기
        </a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
    
 

   <!-- CallToAction Widget ************ -->

  <CallToAction
    title="미래를 위한 코딩 교육을 시작하세요"
    subtitle="CodeBridgeAI Edu와 함께 프로그래밍의 세계로 떠나보세요"
    actions={[
      {
        variant: 'primary',
        text: '무료 체험 시작',
        href: '#',
        icon: 'tabler:play',
        'data-trial-modal': true,
      },
      {
        variant: 'secondary',
        text: '상담 문의',
        href: 'https://codebridge.ai.kr/contact/',
        target: '_blank',
        icon: 'tabler:message',
      },
    ]}
  />

  <!-- 무료 체험 선택 모달 -->
  <div id="trialModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
    <div class="bg-white dark:bg-gray-800 rounded-lg p-8 max-w-md w-full mx-4">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white">무료 체험 선택</h3>
        <button id="closeModal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <p class="text-gray-600 dark:text-gray-300 mb-6">체험하고 싶은 플랫폼을 선택해주세요.</p>
      <div class="space-y-3">
        <a 
          href="https://hypy.codebridge.ai.kr" 
          target="_blank"
          class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 text-center"
        >
          🎮 CodeBEE 무료 체험
        </a>
        <a 
          href="https://aiot.codebridge.ai.kr" 
          target="_blank"
          class="block w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 text-center"
        >
          🔧 CodeBEE IoT 무료 체험
        </a>
        <a 
          href="https://lms.codebridge.ai.kr" 
          target="_blank"
          class="block w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 text-center"
        >
          📚 LMS 무료 체험
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // 모달 관련 JavaScript
  function initTrialModal() {
    const modal = document.getElementById('trialModal');
    const closeModal = document.getElementById('closeModal');
    const trialButtons = document.querySelectorAll('[data-trial-modal]');

    // 모달 요소가 존재하지 않으면 종료
    if (!modal || !closeModal) {
      return;
    }

    // 기존 이벤트 리스너 제거 (중복 방지)
    trialButtons.forEach(button => {
      button.removeEventListener('click', handleTrialButtonClick);
      button.addEventListener('click', handleTrialButtonClick);
    });

    closeModal.removeEventListener('click', handleCloseModal);
    closeModal.addEventListener('click', handleCloseModal);

    modal.removeEventListener('click', handleModalBackgroundClick);
    modal.addEventListener('click', handleModalBackgroundClick);

    // ESC 키 이벤트 리스너는 전역적으로 하나만 등록
    if (!window.trialModalEscapeHandler) {
      window.trialModalEscapeHandler = function(e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          modal.classList.add('hidden');
        }
      };
      document.addEventListener('keydown', window.trialModalEscapeHandler);
    }
  }

  function handleTrialButtonClick(e) {
    e.preventDefault();
    const modal = document.getElementById('trialModal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden'; // 스크롤 방지
    }
  }

  function handleCloseModal() {
    const modal = document.getElementById('trialModal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = ''; // 스크롤 복원
    }
  }

  function handleModalBackgroundClick(e) {
    if (e.target === e.currentTarget) {
      handleCloseModal();
    }
  }

  // DOM 로드 시 초기화
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTrialModal);
  } else {
    initTrialModal();
  }

  // Astro 클라이언트 사이드 라우팅 대응
  document.addEventListener('astro:after-swap', initTrialModal);
</script>
