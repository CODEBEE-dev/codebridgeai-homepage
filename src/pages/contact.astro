---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- Features2 Widget ************** -->

  <Features2
    title="CodeBridgeAI 문의하기"
    items={[      
      {
        title: 'kakao',
        description: '카카오톡으로 문의하기',
        icon: 'tabler:brand-kako-talk',
        callToAction: {
          text: '카카오톡 채널로 이동',
          href: 'https://pf.kakao.com/_aEFxnn',
          variant: 'primary',
          target: '_blank',
        },
      },
      {
        title: 'Email',
        description: 'codebridge@codebridge.ai.kr </br>이메일로 문의하기',
        icon: 'tabler:mail',
        callToAction: {
          text: '이메일 주소 복사',
          href: '#',
          variant: 'primary',
          id: 'copy-email-btn',
        },
      },
      {
        title: 'Instagram',
        description: '인스타그램으로 문의하기',
        icon: 'tabler:brand-instagram',
        callToAction: {
          text: '인스타그램으로 이동',
          href: 'https://www.instagram.com/codebridge.ai_official?igsh=eWJsNDg3cXpmdWh6',
          variant: 'primary',
          target: '_blank',
        },
      },
    ]}
      />
  </Layout>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const copyBtn = document.getElementById('copy-email-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const email = 'codebridge@codebridge.ai.kr';
          
          navigator.clipboard.writeText(email).then(function() {
            // 버튼 텍스트를 임시로 변경하여 복사 완료 표시
            const originalText = copyBtn.textContent;
            copyBtn.textContent = '복사 완료!';
            copyBtn.style.backgroundColor = '#10B981'; // 초록색으로 변경
            
            setTimeout(function() {
              copyBtn.textContent = originalText;
              copyBtn.style.backgroundColor = ''; // 원래 색상으로 복원
            }, 2000);
          }).catch(function(err) {
            console.error('클립보드 복사 실패:', err);
            alert('이메일 주소 복사에 실패했습니다.');
          });
        });
      }
    });
  </script>
